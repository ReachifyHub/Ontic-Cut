<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_nav_docked"
    android:padding="16dp"
    android:elevation="12dp">

    <!-- Header & Invert Toggle Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Video Masking"
            android:textColor="@color/textColor"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchInvertMask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Invert"
            android:textSize="13sp"
            android:textColor="@color/textColor"
            android:fontFamily="sans-serif-medium" />
    </RelativeLayout>

    <!-- Horizontal Scrollable Mask Shape Cards (Filters Style) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- None -->
            <LinearLayout
                android:id="@+id/btnMaskNone"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/bgMaskNone"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_aspect_ratio_item">
                    <ImageView
                        android:id="@+id/imgMaskNone"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_close_24"
                        app:tint="@color/toolTextInactive" />
                </FrameLayout>
                <TextView
                    android:id="@+id/txtMaskNone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="None"
                    android:textSize="11sp"
                    android:textColor="@color/textColor"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Split -->
            <LinearLayout
                android:id="@+id/btnMaskSplit"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/bgMaskSplit"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_aspect_ratio_item">
                    <ImageView
                        android:id="@+id/imgMaskSplit"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_split_24"
                        app:tint="@color/toolTextInactive" />
                </FrameLayout>
                <TextView
                    android:id="@+id/txtMaskSplit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Split"
                    android:textSize="11sp"
                    android:textColor="@color/textColor"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Shutter -->
            <LinearLayout
                android:id="@+id/btnMaskShutter"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/bgMaskShutter"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_aspect_ratio_item">
                    <ImageView
                        android:id="@+id/imgMaskShutter"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shutter_24"
                        app:tint="@color/toolTextInactive" />
                </FrameLayout>
                <TextView
                    android:id="@+id/txtMaskShutter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shutter"
                    android:textSize="11sp"
                    android:textColor="@color/textColor"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Ellipse -->
            <LinearLayout
                android:id="@+id/btnMaskEllipse"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/bgMaskEllipse"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_aspect_ratio_item">
                    <ImageView
                        android:id="@+id/imgMaskEllipse"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_ellipse_24"
                        app:tint="@color/toolTextInactive" />
                </FrameLayout>
                <TextView
                    android:id="@+id/txtMaskEllipse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ellipse"
                    android:textSize="11sp"
                    android:textColor="@color/textColor"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Rectangle -->
            <LinearLayout
                android:id="@+id/btnMaskRectangle"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/bgMaskRectangle"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_aspect_ratio_item">
                    <ImageView
                        android:id="@+id/imgMaskRectangle"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_crop_square_24"
                        app:tint="@color/toolTextInactive" />
                </FrameLayout>
                <TextView
                    android:id="@+id/txtMaskRectangle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rectangle"
                    android:textSize="11sp"
                    android:textColor="@color/textColor"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Heart -->
            <LinearLayout
                android:id="@+id/btnMaskHeart"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/bgMaskHeart"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_aspect_ratio_item">
                    <ImageView
                        android:id="@+id/imgMaskHeart"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_heart_24"
                        app:tint="@color/toolTextInactive" />
                </FrameLayout>
                <TextView
                    android:id="@+id/txtMaskHeart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heart"
                    android:textSize="11sp"
                    android:textColor="@color/textColor"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Star -->
            <LinearLayout
                android:id="@+id/btnMaskStar"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/bgMaskStar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_aspect_ratio_item">
                    <ImageView
                        android:id="@+id/imgMaskStar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_star_24"
                        app:tint="@color/toolTextInactive" />
                </FrameLayout>
                <TextView
                    android:id="@+id/txtMaskStar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Star"
                    android:textSize="11sp"
                    android:textColor="@color/textColor"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Adjustments Section (Feathering, Size, Rotation Sliders) -->
    <LinearLayout
        android:id="@+id/layoutMaskAdjustments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <!-- Feathering Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Feathering"
                android:textSize="12sp"
                android:textColor="@color/textColor"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvFeatherValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="12sp"
                android:textColor="@color/colorPrimary"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderMaskFeather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1"
            app:thumbColor="@color/colorPrimary"
            app:trackColorActive="@color/colorPrimary"
            app:trackColorInactive="@color/surfaceContainerHigh" />

        <!-- Scale / Size Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Size / Scale"
                android:textSize="12sp"
                android:textColor="@color/textColor"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvSizeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textSize="12sp"
                android:textColor="@color/colorPrimary"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderMaskSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="10"
            android:valueTo="200"
            android:value="100"
            android:stepSize="1"
            app:thumbColor="@color/colorPrimary"
            app:trackColorActive="@color/colorPrimary"
            app:trackColorInactive="@color/surfaceContainerHigh" />

        <!-- Rotation Angle Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rotation Angle"
                android:textSize="12sp"
                android:textColor="@color/textColor"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvRotationValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0°"
                android:textSize="12sp"
                android:textColor="@color/colorPrimary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/btnResetRotation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset Angle"
                android:textSize="11sp"
                android:textColor="@color/toolTextInactive"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderMaskRotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="-180"
            android:valueTo="180"
            android:value="0"
            android:stepSize="1"
            app:thumbColor="@color/colorPrimary"
            app:trackColorActive="@color/colorPrimary"
            app:trackColorInactive="@color/surfaceContainerHigh" />
    </LinearLayout>

    <!-- Bottom Action Bar (Reset & Done) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetMask"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:text="Reset All"
            android:textColor="@color/colorPrimary"
            app:strokeColor="@color/colorPrimary"
            app:strokeWidth="1.5dp"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDoneMaskSheet"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:text="@string/done"
            android:textColor="@color/colorOnPrimary"
            android:backgroundTint="@color/colorPrimary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </RelativeLayout>

</LinearLayout>
