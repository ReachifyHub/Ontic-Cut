<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- Bottom Sheet Drag Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:alpha="0.4"
            android:background="@color/outlineVariant" />

        <!-- Title and Close Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/btnCloseAutoAssemble">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_bolt_24"
                    app:tint="@color/colorPrimary"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvAutoAssembleTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_auto_assemble"
                    android:textColor="@color/textColor"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCloseAutoAssemble"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close_24"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="Close"
                app:tint="@color/activeTool" />
        </RelativeLayout>

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:text="@string/str_auto_assemble_desc"
            android:textColor="@color/toolTextInactive"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="16dp" />

        <!-- Timeline Info Card (Voiceover & Visuals info) -->
        <LinearLayout
            android:id="@+id/layoutTimelinePrereqInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_aspect_ratio_item"
            android:padding="12dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_mic_24"
                    app:tint="@color/colorPrimary" />

                <TextView
                    android:id="@+id/tvVoiceoverTrackName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Voiceover: voice_over.m4a"
                    android:textColor="@color/textColor"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:ellipsize="middle" />

                <TextView
                    android:id="@+id/tvVoiceoverTrackDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:15"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_layers_24"
                    app:tint="@color/colorPrimary" />

                <TextView
                    android:id="@+id/tvVisualsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Visuals: 1 sequence clip"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>
        </LinearLayout>

        <!-- Script Map Header with Sample and Clear buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/str_script_map"
                android:textColor="@color/textColor"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/btnPasteSampleScript"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_paste_sample_script"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="?attr/selectableItemBackground"
                android:padding="6dp" />

            <TextView
                android:id="@+id/btnClearScript"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/str_clear_script"
                android:textColor="@color/toolTextInactive"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="?attr/selectableItemBackground"
                android:padding="6dp" />
        </LinearLayout>

        <!-- Large Multi-line Script Map Input -->
        <EditText
            android:id="@+id/etScriptMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:minLines="6"
            android:maxLines="12"
            android:gravity="top|start"
            android:scrollbars="vertical"
            android:background="@drawable/bg_aspect_ratio_item"
            android:padding="14dp"
            android:hint="@string/str_script_map_hint"
            android:textColorHint="@color/toolTextInactive"
            android:textColor="@color/textColor"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:inputType="textMultiLine|textCapSentences"
            android:layout_marginBottom="16dp" />

        <!-- Primary Action Button: Calculate Scenes -->
        <Button
            android:id="@+id/btnCalculateScenes"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/rounded_button"
            android:text="@string/str_calculate_scenes"
            android:textColor="@color/colorOnPrimary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false"
            android:elevation="4dp" />

        <!-- Loading / Progress State -->
        <LinearLayout
            android:id="@+id/layoutAutoAssembleProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_aspect_ratio_item"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbAutoAssemble"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tvAutoAssembleStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="@string/str_calculating_scenes"
                android:textColor="@color/textColor"
                android:textSize="13sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Error State Container -->
        <LinearLayout
            android:id="@+id/layoutAutoAssembleError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_aspect_ratio_item"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_warning_24"
                app:tint="@android:color/holo_red_light" />

            <TextView
                android:id="@+id/tvAutoAssembleError"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Error message"
                android:textColor="@android:color/holo_red_light"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Results Container (Generated Scene Boundaries) -->
        <LinearLayout
            android:id="@+id/layoutAutoAssembleResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvResultsSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Calculated Scene Boundaries"
                    android:textColor="@color/textColor"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/tvResultsCacheBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_duration_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Cached"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Container where item_scene_boundary views are dynamically added -->
            <LinearLayout
                android:id="@+id/layoutScenesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Phase 5 Assembly Confirmation Section -->
            <LinearLayout
                android:id="@+id/layoutAssemblyConfirmation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:padding="16dp"
                android:background="@drawable/bg_aspect_ratio_item"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Timeline Assembly Preview"
                    android:textColor="@color/textColor"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold"
                    android:layout_marginBottom="8dp" />

                <!-- Summary Details -->
                <TextView
                    android:id="@+id/tvAssemblyScenesSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scenes: 4 (3 matched, 1 unmatched)"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvAssemblyImagesSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Images: 8 images on timeline"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvAssemblyDistributionSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Distribution: Scene 1 (2), Scene 2 (2)..."
                    android:textColor="@color/toolTextInactive"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvAssemblyClipDurationSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Average clip duration: 1,850 ms"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginBottom="8dp" />

                <!-- Warning Container (Unmatched or Short clip warning) -->
                <LinearLayout
                    android:id="@+id/layoutAssemblyWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@drawable/bg_aspect_ratio_item"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_warning_24"
                        app:tint="@android:color/holo_orange_light" />

                    <TextView
                        android:id="@+id/tvAssemblyWarningText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Warning note"
                        android:textColor="@android:color/holo_orange_light"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Buttons: Assemble & Cancel -->
                <LinearLayout
                    android:id="@+id/layoutAssemblyActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnCancelAssembly"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_button_dark"
                        android:text="@string/cancel"
                        android:textColor="@color/textColor"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnAssembleTimeline"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1.5"
                        android:background="@drawable/rounded_button"
                        android:text="Assemble"
                        android:textColor="@color/colorOnPrimary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false"
                        android:elevation="2dp" />
                </LinearLayout>

                <!-- Loading indicator for assembly -->
                <LinearLayout
                    android:id="@+id/layoutAssemblingProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Assembling timeline..."
                        android:textColor="@color/textColor"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
