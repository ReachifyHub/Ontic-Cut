<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_bottom_nav_floating"
            android:padding="24dp"
            android:elevation="12dp"
            android:gravity="center_horizontal">

            <!-- App Logo -->
            <ImageView
                android:id="@+id/ivOnboardingLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="Vydra App Icon" />

            <!-- App Name -->
            <TextView
                android:id="@+id/tvOnboardingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/textColor"
                android:textSize="26sp"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium" />

            <!-- Version Chip -->
            <TextView
                android:id="@+id/tvOnboardingVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 0.1.0"
                android:textColor="@color/colorSecondary"
                android:textSize="12sp"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_pill_accent"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp" />

            <!-- Value Proposition Tagline -->
            <TextView
                android:id="@+id/tvOnboardingTagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str_onboarding_tagline"
                android:textColor="@color/textColor"
                android:textSize="15sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif" />

            <!-- Primary Action: Get Started -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOnboardingGetStarted"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/str_get_started"
                android:textColor="@color/onPrimaryContainer"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:backgroundTint="@color/colorPrimary"
                app:cornerRadius="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:elevation="0dp" />

            <!-- Secondary Action: Join our WhatsApp community -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOnboardingWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/str_join_whatsapp_community"
                android:textColor="@color/textColor"
                android:backgroundTint="@color/surfaceContainerHigh"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                app:icon="@drawable/ic_whatsapp_24"
                app:iconTint="#25D366"
                app:iconGravity="textStart"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <!-- Small Privacy Policy Link -->
            <TextView
                android:id="@+id/tvOnboardingPrivacyPolicy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:padding="8dp"
                android:text="@string/str_privacy_policy"
                android:textColor="@color/iconSecondary"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
