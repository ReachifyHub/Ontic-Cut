<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Volume Panel (Hidden by default, toggled via Volume button) -->
    <LinearLayout
        android:id="@+id/audioVolumePanel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bottom_nav_floating"
        android:paddingHorizontal="16dp"
        android:elevation="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_volume_up_24"
            android:contentDescription="@string/str_volume"
            app:tint="@color/iconSecondary" />

        <com.google.android.material.slider.Slider
            android:id="@+id/audioVolumeSlider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:valueFrom="0.0"
            android:valueTo="2.0"
            android:value="1.0"
            app:thumbColor="@color/colorPrimary"
            app:trackColorActive="@color/colorPrimary" />

        <TextView
            android:id="@+id/tvAudioVolumeValue"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/str_100"
            android:textColor="@color/textColor"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/btnVolumeCancel"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_24"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/cancel"
            app:tint="@color/toolTextInactive" />

        <ImageButton
            android:id="@+id/btnVolumeDone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_check_24"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/done"
            app:tint="@color/colorPrimary" />
    </LinearLayout>

    <!-- Audio Trim Panel (Hidden by default, toggled via Trim button) -->
    <LinearLayout
        android:id="@+id/audioTrimPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_nav_floating"
        android:padding="16dp"
        android:elevation="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_audio_segment"
                android:textColor="@color/textColor"
                android:fontFamily="sans-serif-medium"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvAudioTrimValues"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_0_0s_0_0s"
                android:textColor="@color/outline"
                android:textSize="12sp"/>
        </LinearLayout>

        <com.boostlyte.vydra.customviews.TrackTrimView
            android:id="@+id/audioTrimTrack"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp" />

        <ImageButton
            android:id="@+id/btnAudioPreviewPlay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_play_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/str_preview"
            app:tint="@color/colorPrimary" />
    </LinearLayout>

    <!-- Toolbar Row: Trim, Volume, Fade, Ducking, Beats, Delete, Done -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none"
        android:background="@drawable/bg_bottom_nav_docked"
        android:elevation="12dp"
        android:clipToOutline="true"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="32dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:paddingHorizontal="4dp">

            <!-- 1. Trim -->
            <LinearLayout
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnAudioTrim"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/tool_button_inactive"
                    android:src="@drawable/ic_trim_24"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/trim"
                    app:tint="@color/toolTextInactive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/trim"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/toolTextInactive"/>
            </LinearLayout>

            <!-- 2. Volume -->
            <LinearLayout
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnAudioVolume"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/tool_button_inactive"
                    android:src="@drawable/ic_volume_up_24"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/str_volume"
                    app:tint="@color/toolTextInactive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/str_volume"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/toolTextInactive"/>
            </LinearLayout>

            <!-- 3. Fade -->
            <LinearLayout
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnAudioFade"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/tool_button_inactive"
                    android:src="@drawable/ic_fade"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/str_fade"
                    app:tint="@color/toolTextInactive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/str_fade"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/toolTextInactive"/>
            </LinearLayout>

            <!-- 4. Ducking -->
            <LinearLayout
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnAudioDucking"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/tool_button_inactive"
                    android:src="@drawable/ic_ducking"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/str_ducking"
                    app:tint="@color/toolTextInactive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/str_ducking"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/toolTextInactive"/>
            </LinearLayout>

            <!-- 5. Beats -->
            <LinearLayout
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnAudioBeats"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/tool_button_inactive"
                    android:src="@drawable/ic_bolt_24"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/str_beats"
                    app:tint="@color/toolTextInactive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/str_beats"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/toolTextInactive"/>
            </LinearLayout>

            <!-- 6. Delete -->
            <LinearLayout
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnAudioDelete"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/tool_button_inactive"
                    android:src="@drawable/ic_delete_24"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/delete"
                    app:tint="#F44336" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/delete"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#F44336"/>
            </LinearLayout>

            <!-- 7. Done -->
            <LinearLayout
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnAudioDone"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/tool_button_inactive"
                    android:src="@drawable/ic_check_24"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/done"
                    app:tint="@color/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/done"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/colorPrimary"/>
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
