<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_hero_bento_secondary"
    android:padding="12dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="64dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#25FFFFFF"
        app:cardBackgroundColor="@color/colorSurface">

        <ImageView
            android:id="@+id/ivProjectThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Project Thumbnail" />

        <FrameLayout
            android:id="@+id/layoutFallbackIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/circle_primary_container">

            <ImageView
                android:id="@+id/ivProjectIconFallback"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_clips_24"
                app:tint="@color/onPrimaryContainer"
                android:contentDescription="Project Icon" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvProjectName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/textColor"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvProjectDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/iconSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnProjectMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_more_vert_24"
        android:scaleType="centerInside"
        android:padding="12dp"
        app:tint="@color/iconSecondary"
        android:contentDescription="Project options" />

</LinearLayout>
