<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_nav_docked"
    android:padding="16dp">

    <!-- Handle indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#40FFFFFF" />

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btnCloseFontManager">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Font Manager"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Import and select custom fonts (.ttf / .otf)"
                android:textColor="#A0A0A0"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseFontManager"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_24"
            app:tint="#FFFFFF" />
    </RelativeLayout>

    <!-- Import Font Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnImportFont"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="Import Local Font (.ttf / .otf)"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        app:icon="@drawable/ic_add_24"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF"
        app:cornerRadius="12dp"
        android:backgroundTint="@color/colorPrimary" />

    <!-- List of Fonts -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFonts"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/tvEmptyFonts"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="No fonts found"
        android:textColor="#80FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
