<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingBottom="24dp"
    android:paddingTop="12dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:alpha="0.4"
        android:background="@color/outlineVariant" />

    <!-- Header with Title and Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvTitleCanvasRatio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"
            android:text="@string/str_canvas_aspect_ratio"
            android:textColor="@color/textColor"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/btnCloseRatioSheet"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_24"
            android:padding="8dp"
            android:contentDescription="@string/cancel"
            app:tint="@color/activeTool" />
    </RelativeLayout>

    <!-- Ratio Options Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- 16:9 Landscape Option -->
        <LinearLayout
            android:id="@+id/itemRatio16_9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_aspect_ratio_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:id="@+id/ivIcon16_9"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_crop_16_9_24"
                android:contentDescription="@string/str_ratio_16_9"
                app:tint="@color/activeTool" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRatio16_9Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/str_ratio_16_9"
                    android:textColor="@color/textColor"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/str_ratio_16_9_desc"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivCheck16_9"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check_24"
                android:contentDescription="@string/done"
                android:visibility="gone"
                app:tint="@color/activeTool" />
        </LinearLayout>

        <!-- 9:16 Portrait Option -->
        <LinearLayout
            android:id="@+id/itemRatio9_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_aspect_ratio_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:id="@+id/ivIcon9_16"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_crop_portrait_24"
                android:contentDescription="@string/str_ratio_9_16"
                app:tint="@color/activeTool" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRatio9_16Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/str_ratio_9_16"
                    android:textColor="@color/textColor"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/str_ratio_9_16_desc"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivCheck9_16"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check_24"
                android:contentDescription="@string/done"
                android:visibility="gone"
                app:tint="@color/activeTool" />
        </LinearLayout>

        <!-- 1:1 Square Option -->
        <LinearLayout
            android:id="@+id/itemRatio1_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_aspect_ratio_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:id="@+id/ivIcon1_1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_crop_square_24"
                android:contentDescription="@string/str_ratio_1_1"
                app:tint="@color/activeTool" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRatio1_1Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/str_ratio_1_1"
                    android:textColor="@color/textColor"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/str_ratio_1_1_desc"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivCheck1_1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check_24"
                android:contentDescription="@string/done"
                android:visibility="gone"
                app:tint="@color/activeTool" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
