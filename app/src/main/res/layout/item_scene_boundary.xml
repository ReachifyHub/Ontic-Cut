<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_aspect_ratio_item"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvSceneNumber"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/circle_primary_container"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/onPrimaryContainer"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold" />

        <TextView
            android:id="@+id/tvSceneTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:text="Scene 1"
            android:textColor="@color/textColor"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvSceneStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_duration_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Matched"
            android:textColor="@color/colorPrimary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_duration_24"
            app:tint="@color/toolTextInactive" />

        <TextView
            android:id="@+id/tvSceneTimeRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="0:00 - 0:12"
            android:textColor="@color/toolTextInactive"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSceneScriptSnippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Welcome to the channel."
        android:textColor="@color/colorOnSecondary"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:alpha="0.8" />
</LinearLayout>
